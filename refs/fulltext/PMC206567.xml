"H">H</given-names></name></contrib></contrib-group><aff>Mikrobiologisches Institut, Eidgenössische Technische Hochschule, ETH-Zentrum, Zürich, Switzerland.</aff><pub-date pub-type="ppub"><month>3</month><year>1992</year></pub-date><volume>174</volume><issue>5</issue><issue-id pub-id-type="pmc-issue-id">6547</issue-id><fpage>1686</fpage><lpage>1689</lpage><pub-history><event event-type="pmc-release"><date><day>01</day><month>03</month><year>1992</year></date></event><event event-type="pmc-live"><date><day>01</day><month>12</month><year>2003</year></date></event><event event-type="pmc-last-change"><date iso-8601-date="2019-10-31 12:56:09.613"><day>31</day><month>10</month><year>2019</year></date></event></pub-history><self-uri xmlns:xlink="http://www.w3.org/1999/xlink" content-type="pmc-pdf" xlink:href="jbacter00071-0264.pdf"/><abstract><p>The pheS5 mutation responsible for the thermosensitive phenylalanyl-tRNA synthetase of the classical Escherichia coli NP37 was cloned by a recombination event and identified by DNA sequence analysis. The mutation was subsequently verified by direct sequencing of amplified NP37 DNA generated by an asymmetric polymerase chain reaction. The resulting amino acid exchange, Gly-98 to Asp-98 in the phenylalanyl-tRNA synthetase alpha subunit, might cause subunit disaggregation due to electrostatic repulsion.</p><sec sec-type="scanned-figures"><title>Images</title><fig id="F1" position="float" orientation="portrait"><graphic xmlns:xlink="http://www.w3.org/1999/xlink" xlink:role="1687" position="float" xlink:href="jbacter00071-0265-a.jpg" orientation="portrait"/></fig></sec></abstract><custom-meta-group><custom-meta><meta-name>pmc-status-qastatus</meta-name><meta-value>0</meta-value></custom-meta><custom-meta><meta-name>pmc-status-live</meta-name><meta-value>yes</meta-value></custom-meta><custom-meta><meta-name>pmc-status-embargo</meta-name><meta-value>no</meta-value></custom-meta><custom-meta><meta-name>pmc-status-released</meta-name><meta-