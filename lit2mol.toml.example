# Example lit2mol configuration.
#
# Copy this file to `lit2mol.toml` (auto-discovered in the working directory)
# or pass it explicitly:
#
#   python -m lit2mol.extract --config lit2mol.toml
#
# Precedence: command-line arguments > this file > environment variables > defaults.

[vllm]
base_url = "http://gpu-host:8000/v1"
api_key = "EMPTY"
model = "nvidia/Llama-3.1-8B-Instruct"
structured_mode = "guided_json"   # or "response_format"
temperature = 0.0
top_p = 1.0
max_tokens = 8192
max_input_chars = 120000
timeout = 600.0
# seed = 42

[extraction]
paths = ["refs/fulltext"]
focus = "phenylalanyl-tRNA synthetase (PheS/PheT)"
out_dir = "outputs/phes"
pattern = "*.txt"
# limit = 10
concurrency = 8

# Protein-complex screening (python -m lit2mol.screen); see docs/screening.md.
# The API key is read from TYPESAFE_API_KEY; avoid committing it here.
[typesafe]
model = "jev-latest"
# timeout = 120.0
# max_chunk_chars = 80000

[screen]
paths = ["refs/fulltext"]
focus = "phenylalanyl-tRNA synthetase (PheS/PheT)"
out_dir = "outputs/screen/phes"
pattern = "*.xml"
concurrency = 8
